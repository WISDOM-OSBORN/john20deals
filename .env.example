# ============================================================
# John20 Deals - Environment Variables
# Copy this file to `.env` (local dev) and configure the same
# variables in Netlify (Site settings > Environment variables).
# ============================================================

# ------------------------------------------------------------
# Cloudflare R2 (image uploads)
# Uploads go to Cloudflare R2 via presigned URLs, so you need
# an R2 bucket + API token. The bucket must allow public read.
# ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ------------------------------------------------------------
# Clerk Authentication
# Public publishable key - safe to expose in the client.
# Admin access is granted via publicMetadata.role === 'admin'
# (set in the Clerk dashboard) or a legacy admin email.
# ------------------------------------------------------------
VITE_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# Supabase
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are used ONLY for
# public product/review reads on the client.
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are SERVER-ONLY and
# drive all Netlify Functions (admin dashboard, orders, swap,
# sell, repair, notifications, profile sync, reviews, newsletter).
# NEVER expose the service role key in the client.
# ------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# CORS (Netlify Functions)
# Comma-separated list of allowed browser origins that may call
# the API functions (e.g. https://john20deals.netlify.app).
# `process.env.URL` (set automatically by Netlify) and localhost
# are always allowed. Leave empty to allow only localhost + the
# Netlify site URL.
# ------------------------------------------------------------
ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Admin WhatsApp number used for manual deep-links from the
# cart checkout (fallback is 233505694171).
# ------------------------------------------------------------
VITE_ADMIN_WHATSAPP=233505694171
